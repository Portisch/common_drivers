From 2b0b66f961afb7d4d7b697b7f97a17640e677200 Mon Sep 17 00:00:00 2001
From: Fuad Tabba <tabba@google.com>
Date: Tue, 31 Mar 2026 09:01:57 +0000
Subject: [PATCH 093/223] ANDROID: KVM: arm64: Fix TRBE and SPE handling during
 pKVM world switch

When running a protected VM (pKVM), the hypervisor intentionally skips
copying `iflags` from the host to the shadow vCPU in `flush_hyp_vcpu()`.
This causes `DEBUG_STATE_SAVE_TRBE` and `DEBUG_STATE_SAVE_SPE` to
evaluate to 0 at EL2, meaning the hypervisor never runs the debug
save routines to disable them.

Leaving the Trace Buffer Extension (TRBE) active while running the guest
causes the TRBE to continuously attempt to write trace data to Host
Virtual Addresses using the guest's Stage-2 translation tables. This
results in a storm of Stage-2 MMU faults and eventually a hard lockup
during TLB invalidation (`tlbi`) handshakes.

The Android 17 equivalent fix does not apply cleanly to this branch
due to structural differences in how host state is tracked. Instead of
relying on host `iflags` or backporting the A17 `__is_trbe_enabled()`
logic, we resolve this directly at EL2.

Fix this by explicitly checking the sanitized hardware register
`SYS_ID_AA64DFR0_EL1` during vCPU initialization in
`init_pkvm_hyp_vcpu()` for all VMs. If the hardware supports TRBE or
SPE, we explicitly set the corresponding flags (`DEBUG_STATE_SAVE_TRBE`,
`DEBUG_STATE_SAVE_SPE`) on the hyp vCPU.

To ensure the untrusted host cannot undermine this for non-protected
VMs by clearing the flags in its `iflags` variable, we define a strict
`PKVM_ALLOWED_HOST_IFLAGS` mask. During `flush_hyp_vcpu()`, EL2 safely
merges only the allowed flags (like `PC_UPDATE_REQ` and `DEBUG_DIRTY`)
across the boundary, guaranteeing that EL2 maintains exclusive control
over its debug hardware state logic. On exit, in `sync_hyp_vcpu()`, the
hypervisor synchronizes the entire `iflags` state back to the host,
ensuring the host remains aware of the debug bits being set or cleared.

Since these hardware features do not change dynamically, we perform
this check and flag initialization exactly once during vCPU initialization
rather than on every world switch. This ensures the debug states are
correctly evaluated and disabled before entering the guest while avoiding
unnecessary overhead during `flush_hyp_vcpu()`.

Bug: 473214797
Change-Id: I1bd58bd5a2283ad6cf87934a3f633000076bd110
Signed-off-by: Fuad Tabba <tabba@google.com>
(cherry picked from commit 057c115fcd4bbe6919a6af5ee9721988866b78f8)
Bug: 504744760
---
 arch/arm64/include/asm/kvm_hyp.h   |  1 +
 arch/arm64/include/asm/kvm_pkvm.h  | 10 ++++++++++
 arch/arm64/kvm/arm.c               |  1 +
 arch/arm64/kvm/hyp/nvhe/hyp-main.c |  4 +++-
 arch/arm64/kvm/hyp/nvhe/pkvm.c     | 13 +++++++++++++
 arch/arm64/kvm/hyp/nvhe/sys_regs.c |  1 +
 6 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/include/asm/kvm_hyp.h b/arch/arm64/include/asm/kvm_hyp.h
index 0257e8e37434..4084037e1172 100644
--- a/arch/arm64/include/asm/kvm_hyp.h
+++ b/arch/arm64/include/asm/kvm_hyp.h
@@ -148,6 +148,7 @@ extern u64 kvm_nvhe_sym(id_aa64mmfr0_el1_sys_val);
 extern u64 kvm_nvhe_sym(id_aa64mmfr1_el1_sys_val);
 extern u64 kvm_nvhe_sym(id_aa64mmfr2_el1_sys_val);
 extern u64 kvm_nvhe_sym(id_aa64smfr0_el1_sys_val);
+extern u64 kvm_nvhe_sym(id_aa64dfr0_el1_sys_val);
 
 extern unsigned long kvm_nvhe_sym(__icache_flags);
 extern unsigned int kvm_nvhe_sym(kvm_arm_vmid_bits);
diff --git a/arch/arm64/include/asm/kvm_pkvm.h b/arch/arm64/include/asm/kvm_pkvm.h
index db161943f99b..4cd399f4ebe3 100644
--- a/arch/arm64/include/asm/kvm_pkvm.h
+++ b/arch/arm64/include/asm/kvm_pkvm.h
@@ -27,6 +27,16 @@ bool pkvm_is_hyp_created(struct kvm *kvm);
 int pkvm_create_hyp_vcpu(struct kvm_vcpu *vcpu);
 void pkvm_host_reclaim_page(struct kvm *host_kvm, phys_addr_t ipa);
 int pvkm_enable_smc_forwarding(struct file *kvm_file);
+
+/*
+ * Mask of iflags that the host is permitted to update for non-protected VMs.
+ * Crucially excludes DEBUG_STATE_SAVE_SPE and DEBUG_STATE_SAVE_TRBE to
+ * ensure EL2 remains in control of debug hardware state saving.
+ */
+#define PKVM_ALLOWED_HOST_IFLAGS                                           \
+	(unpack_vcpu_flag(PC_UPDATE_REQ) | unpack_vcpu_flag(DEBUG_DIRTY) | \
+	 unpack_vcpu_flag(PKVM_HOST_STATE_DIRTY))
+
 /*
  * This functions as an allow-list of protected VM capabilities.
  * Features not explicitly allowed by this function are denied.
diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index 564abfd58e12..305332011eac 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -2469,6 +2469,7 @@ static void kvm_hyp_init_symbols(void)
 	kvm_nvhe_sym(id_aa64mmfr1_el1_sys_val) = read_sanitised_ftr_reg(SYS_ID_AA64MMFR1_EL1);
 	kvm_nvhe_sym(id_aa64mmfr2_el1_sys_val) = read_sanitised_ftr_reg(SYS_ID_AA64MMFR2_EL1);
 	kvm_nvhe_sym(id_aa64smfr0_el1_sys_val) = read_sanitised_ftr_reg(SYS_ID_AA64SMFR0_EL1);
+	kvm_nvhe_sym(id_aa64dfr0_el1_sys_val) = read_sanitised_ftr_reg(SYS_ID_AA64DFR0_EL1);
 	kvm_nvhe_sym(__icache_flags) = __icache_flags;
 	kvm_nvhe_sym(kvm_arm_vmid_bits) = kvm_arm_vmid_bits;
 	kvm_nvhe_sym(smccc_trng_available) = smccc_trng_available;
diff --git a/arch/arm64/kvm/hyp/nvhe/hyp-main.c b/arch/arm64/kvm/hyp/nvhe/hyp-main.c
index 9c7f0fbc3d19..4f4b56d853c3 100644
--- a/arch/arm64/kvm/hyp/nvhe/hyp-main.c
+++ b/arch/arm64/kvm/hyp/nvhe/hyp-main.c
@@ -808,7 +808,9 @@ static void flush_hyp_vcpu(struct pkvm_hyp_vcpu *hyp_vcpu)
 		if (host_iflags & unpack_vcpu_flag(PKVM_HOST_STATE_DIRTY))
 			__flush_hyp_vcpu(hyp_vcpu);
 
-		hyp_vcpu->vcpu.arch.iflags = host_iflags;
+		hyp_vcpu->vcpu.arch.iflags = (host_iflags & PKVM_ALLOWED_HOST_IFLAGS) |
+			(hyp_vcpu->vcpu.arch.iflags & ~PKVM_ALLOWED_HOST_IFLAGS);
+
 		flush_debug_state(hyp_vcpu);
 
 		hyp_vcpu->vcpu.arch.hcr_el2 &= ~(HCR_TWI | HCR_TWE);
diff --git a/arch/arm64/kvm/hyp/nvhe/pkvm.c b/arch/arm64/kvm/hyp/nvhe/pkvm.c
index 846d085b7021..c87a40c0aaac 100644
--- a/arch/arm64/kvm/hyp/nvhe/pkvm.c
+++ b/arch/arm64/kvm/hyp/nvhe/pkvm.c
@@ -711,6 +711,17 @@ static int pkvm_vcpu_init_sysregs(struct pkvm_hyp_vcpu *hyp_vcpu)
 	return ret;
 }
 
+static void pkvm_vcpu_init_debug_state(struct pkvm_hyp_vcpu *hyp_vcpu)
+{
+	struct kvm_vcpu *vcpu = &hyp_vcpu->vcpu;
+
+	if (FIELD_GET(ID_AA64DFR0_EL1_PMSVer, id_aa64dfr0_el1_sys_val))
+		vcpu_set_flag(vcpu, DEBUG_STATE_SAVE_SPE);
+
+	if (FIELD_GET(ID_AA64DFR0_EL1_TraceBuffer, id_aa64dfr0_el1_sys_val))
+		vcpu_set_flag(vcpu, DEBUG_STATE_SAVE_TRBE);
+}
+
 static int init_pkvm_hyp_vcpu(struct pkvm_hyp_vcpu *hyp_vcpu,
 			      struct pkvm_hyp_vm *hyp_vm,
 			      struct kvm_vcpu *host_vcpu)
@@ -767,6 +778,8 @@ static int init_pkvm_hyp_vcpu(struct pkvm_hyp_vcpu *hyp_vcpu,
 	ret = pkvm_vcpu_init_psci(hyp_vcpu, mp_state);
 	if (ret)
 		goto done;
+
+	pkvm_vcpu_init_debug_state(hyp_vcpu);
 done:
 	if (ret)
 		unpin_host_vcpu(hyp_vcpu);
diff --git a/arch/arm64/kvm/hyp/nvhe/sys_regs.c b/arch/arm64/kvm/hyp/nvhe/sys_regs.c
index f73ddefa9a5b..508ce5514206 100644
--- a/arch/arm64/kvm/hyp/nvhe/sys_regs.c
+++ b/arch/arm64/kvm/hyp/nvhe/sys_regs.c
@@ -28,6 +28,7 @@ u64 id_aa64mmfr0_el1_sys_val;
 u64 id_aa64mmfr1_el1_sys_val;
 u64 id_aa64mmfr2_el1_sys_val;
 u64 id_aa64smfr0_el1_sys_val;
+u64 id_aa64dfr0_el1_sys_val;
 
 struct pvm_ftr_bits {
 	bool		sign;
-- 
2.50.1

